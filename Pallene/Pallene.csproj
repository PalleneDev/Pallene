<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
	  <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Remove="Assets\mynaui-solid.axaml" />
    <AvaloniaResource Remove="Assets\mynaui.axaml" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Fonts\FluentIcons.ttf" />
    <None Remove="Fonts\FunnelSans-Italic.ttf" />
    <None Remove="Fonts\FunnelSans.ttf" />
    <None Remove="Fonts\remixicon.ttf" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Fonts\FunnelSans-Italic.ttf" />
    <AvaloniaResource Include="Fonts\FunnelSans.ttf" />
    <AvaloniaResource Include="Fonts\PlneChrome.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.2">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="IconPacks.Avalonia.MynaUIIcons" Version="2.0.0" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.11" />
    <PackageReference Include="Svg.Skia" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaXaml Update="Assets\mynaui.axaml">
      <SubType>Designer</SubType>
    </AvaloniaXaml>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaXaml Update="Assets\mynaui-solid.axaml">
      <SubType>Designer</SubType>
    </AvaloniaXaml>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Versioning.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Versioning.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Versioning.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Versioning.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
</Project>
